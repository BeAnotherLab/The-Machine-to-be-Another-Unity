--- !u!114 &1153005247
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1153005245}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: "We hope you enjoyed your experience. \n\nThank you!"
    Object: {fileID: 0}
  - Language: German
    Text: 'Wir hoffen, dass Sie die Erfahrung genossen haben.


      Vielen Dank!'
    Object: {fileID: 0}
  - Language: French
    Text: "Nous esp\xE9rons que vous avez appr\xE9ci\xE9 votre exp\xE9rience. \n\nMerci!"
    Object: {fileID: 0}
  - Language: Italian
    Text: "Speriamo che ti sia piaciuta la tua esperienza. \n\nGrazie!"
    Object: {fileID: 0}
  - Language: Polish
    Text: "Mamy nadziej\u0119, \u017Ce podoba\u0142o Ci si\u0119 to do\u015Bwiadczenie.\nDzi\u0119kujemy!"
    Object: {fileID: 0}
