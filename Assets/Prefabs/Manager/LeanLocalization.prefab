  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: please take a moment to breathe calmly...
    Object: {fileID: 0}
  - Language: German
    Text: 'Willkommen


      Bitte nehmen Sie sich einen Moment Zeit, um ruhig zu
      atmen...'
    Object: {fileID: 0}
  - Language: French
    Text: "Soyez la bienvenue\n\nPrenez s'il vous pla\xEEt un moment pour respirer
      calmement."
    Object: {fileID: 0}
  - Language: Italian
    Text: 'Benvenuto\n\n


      Per favore, prenditi un momento per respirare con
      calma ...'
    Object: {fileID: 0}
  - Language: Polish
    Text: "Witaj, po\u015Bwi\u0119\u0107 chwil\u0119, aby spokojnie pooddycha\u0107\u2026"
    Object: {fileID: 0}
